# ===========================================
# 99cents Production Environment Variables
# ===========================================

# Database (PostgreSQL)
# ЗАПОЛНИТЬ: заменить на реальные данные вашей БД
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://ЗАМЕНИТЬ_USER:ЗАМЕНИТЬ_PASSWORD@ЗАМЕНИТЬ_HOST:5432/ЗАМЕНИТЬ_DATABASE"

# ===========================================
# Web3 / Crypto Payments
# ===========================================

# WalletConnect Project ID (получить на https://cloud.walletconnect.com)
# Нужен для WalletConnect (QR код для мобильных кошельков)
# Браузерные кошельки (MetaMask, Rabby) работают без этого ID
NEXT_PUBLIC_WC_PROJECT_ID="ЗАПОЛНИТЬ_PROJECT_ID"

# Кошелек для ПОЖЕРТВОВАНИЙ (благотворительность)
# Сюда приходят $0.99 от пользователей, потом идут победителям голосования
NEXT_PUBLIC_DONATION_WALLET="0x_ЗАПОЛНИТЬ_АДРЕС_КОШЕЛЬКА"

# Кошелек для ПОДДЕРЖКИ ПРОЕКТА (юр.лицо)
# Сюда приходят добровольные пожертвования на развитие проекта
NEXT_PUBLIC_SUPPORT_WALLET="0x_ЗАПОЛНИТЬ_АДРЕС_КОШЕЛЬКА"

# ===========================================
# Примечания
# ===========================================
# - Оба кошелька должны быть на сети Base (chainId: 8453)
# - Принимается USDC (адрес контракта: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913)
# - Можно использовать один кошелек для обоих целей, но лучше разделить для прозрачности
# - NEXT_PUBLIC_RECIPIENT_ADDRESS больше не используется (заменён на два отдельных)
